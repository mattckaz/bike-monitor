# Bike Deal Finder — Environment Variables
# Copy this to .env for local development

# Sender address (must match the iCloud account EMAIL_APP_PASSWORD belongs to)
EMAIL_ADDRESS=you@icloud.com

# iCloud app-specific password (generate at appleid.apple.com)
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Comma-separated list of alert recipients
NOTIFY_EMAILS=you@icloud.com

# Anthropic API key (get at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
